<misterromdescription>
    <name>Shot Rider</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Shot Rider</series>
    <year>1985</year>
    <manufacturer>Seibu Kaihatsu</manufacturer>
    <category>Driving</category>

    <setname>shtrider</setname>
    <parent>shtrider</parent>
    <mameversion>0289</mameversion>
    <rbf>Irem1</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF">
        <dip name="Coin A" bits="0,2" ids="5C/1C,4C/1C,3C/1C,2C/1C,1C/1C,1C/2C,1C/3C,1C/5C" values="0,4,2,6,7,3,5,1"/>
        <dip name="Coin B" bits="3,4" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="0,2,3,1"/>
        <dip name="Flip Screen" bits="8" ids="Off,On" values="1,0"/>
        <dip name="Speed Display" bits="9" ids="km/h,mph" values="1,0"/>
        <dip name="Fuel Reduced on Collision" bits="10" ids="10%,15%" values="1,0"/>
        <dip name="Cabinet" bits="11" ids="Upright,Cocktail" values="1,0"/>
    </switches>

    <!-- Index 0: MAME regions, packed store of rtl/irem1_board.sv (region table in index 1 bytes 64-111) -->
    <rom index="0" md5="none" zip="shtrider.zip">
