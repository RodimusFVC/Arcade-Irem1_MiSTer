<misterromdescription>
    <name>Alpha One</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Alpha One</series>
    <year>1988</year>
    <manufacturer>Vision Electronics</manufacturer>
    <category>Shooter</category>

    <setname>alpha1v</setname>
    <parent>alpha1v</parent>
    <mameversion>0289</mameversion>
    <rbf>Irem1</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="EE,00">
        <dip name="Lives" bits="0,1" ids="2,3,4,5" values="3,2,1,0"/>
        <dip name="Cabinet" bits="2" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Allow Continue" bits="4" ids="No,Yes" values="1,0"/>
        <dip name="Coin A" bits="8,11" ids="4C/1C,3C/1C,2C/1C,1C/1C" values="11,12,13,0"/>
        <dip name="Coin B" bits="12,15" ids="1C/1C,1C/2C,1C/3C,1C/4C,1C/5C,1C/6C,1C/7C" values="0,13,12,11,10,9,8"/>
    </switches>

    <!-- Index 0: MAME regions, packed store of rtl/irem1_board.sv (region table in index 1 bytes 64-111) -->
    <rom index="0" md5="none" zip="alpha1v.zip">
        <part crc="3a679d34" name="2-m3"/>
        <part crc="2f09df64" name="3-l3"/>
        <part crc="64fb9c8a" name="4-k3"/>
