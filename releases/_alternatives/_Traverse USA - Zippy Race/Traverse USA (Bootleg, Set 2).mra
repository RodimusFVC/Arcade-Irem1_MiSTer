<misterromdescription>
    <name>Traverse USA (Bootleg, Set 2)</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Traverse USA</series>
