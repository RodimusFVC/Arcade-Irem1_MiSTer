<misterromdescription>
    <name>MotoTour / Zippy Race (Tecfri License)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Traverse USA</series>
    <year>1983</year>
    <manufacturer>Irem (Tecfri license)</manufacturer>
    <category>Driving</category>

    <setname>mototour</setname>
    <parent>travrusa</parent>
    <mameversion>0289</mameversion>
    <rbf>Irem1</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="F7,FD">
        <dip name="Fuel Reduced on Collision" bits="0,1" ids="8/120 Dots,10/120 Dots,12/120 Dots,14/120 Dots" values="3,2,1,0"/>
        <dip name="Fuel Consumption" bits="2" ids="Low,High" values="1,0"/>
        <dip name="Allow Continue" bits="3" ids="No,Yes" values="1,0"/>
        <dip name="Flip Screen" bits="8" ids="Off,On" values="1,0"/>
        <dip name="Cabinet" bits="9" ids="Upright,Cocktail"/>
        <dip name="Coin Mode" bits="10" ids="Mode 1,Mode 2" values="1,0"/>
        <dip name="Speed Type" bits="11" ids="mph,km/h" values="1,0"/>
        <dip name="Stop Mode (Cheat)" bits="12" ids="Off,On" values="1,0"/>
        <dip name="Title" bits="13" ids="Traverse USA,Zippy Race" values="1,0"/>
        <dip name="Invulnerability (Cheat)" bits="14" ids="Off,On" values="1,0"/>
        <dip name="Service Mode" bits="15" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: MAME regions, packed store of rtl/irem1_board.sv (region table in index 1 bytes 64-111) -->
    <rom index="0" md5="none" zip="mototour.zip|travrusa.zip">
