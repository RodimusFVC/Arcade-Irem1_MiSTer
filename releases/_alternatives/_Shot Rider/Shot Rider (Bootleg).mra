<misterromdescription>
    <name>Shot Rider (Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Shot Rider</series>
    <year>1985</year>
