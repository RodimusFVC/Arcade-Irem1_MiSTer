<misterromdescription>
    <name>New Tropical Angel</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Tropical Angel</series>
    <year>1983</year>
    <manufacturer>Irem</manufacturer>
    <category>Sports</category>

    <setname>newtangl</setname>
    <parent>troangel</parent>
    <mameversion>0289</mameversion>
    <rbf>Irem1</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FD">
        <dip name="Time" bits="0,1" ids="B:180/A:160/M:140/BG:120,B:160/A:140/M:120/BG:100,B:140/A:120/M:100/BG:80,B:120/A:100/M:100/BG:80" values="3,2,1,0"/>
        <dip name="Crash Loss Time" bits="2" ids="5,10" values="1,0"/>
        <dip name="Background Sound" bits="3" ids="Boat Motor,Music" values="1,0"/>
        <dip name="Coinage" bits="4,7" ids="6C/1C,5C/1C,4C/1C,3C/1C,2C/1C,1C/1C,1C/2C,1C/3C,1C/4C,1C/5C,1C/6C,Free Play" values="10,11,12,13,14,15,7,6,5,4,3,0"/>
        <dip name="Flip Screen" bits="8" ids="Off,On" values="1,0"/>
        <dip name="Cabinet" bits="9" ids="Upright,Cocktail"/>
        <dip name="Coin Mode" bits="10" ids="Mode 1,Mode 2" values="1,0"/>
        <dip name="Invulnerability (Cheat)" bits="14" ids="Off,On" values="1,0"/>
        <dip name="Service Mode" bits="15" ids="Off,On" values="1,0"/>
        <dip name="Analog Accelerator" bits="11" ids="No,Yes" values="1,0"/>
        <dip name="Stop Mode (Cheat)" bits="12" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: MAME regions, packed store of rtl/irem1_board.sv (region table in index 1 bytes 64-111) -->
