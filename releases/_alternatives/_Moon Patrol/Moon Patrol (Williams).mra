<misterromdescription>
    <name>Moon Patrol (Williams)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Moon Patrol</series>
    <year>1982</year>
    <manufacturer>Irem (Williams license)</manufacturer>
    <category>Shooter</category>

    <setname>mpatrolw</setname>
    <parent>mpatrol</parent>
    <mameversion>0289</mameversion>
    <rbf>Irem1</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FE,FD">
        <dip name="Bonus Life" bits="2,3" ids="10000 30000 50000,20000 40000 60000,10000,None" values="3,2,1,0"/>
        <dip name="Coinage" bits="4,7" ids="7C/1C,6C/1C,5C/1C,4C/1C,3C/1C,2C/1C,1C/1C,1C/2C,1C/3C,1C/4C,1C/5C,1C/6C,1C/7C,1C/8C,Free Play" values="9,10,11,12,13,14,15,7,6,5,4,3,2,1,0"/>
        <dip name="Lives" bits="0,1" ids="2,3,4,5"/>
        <dip name="Flip Screen" bits="8" ids="Off,On" values="1,0"/>
        <dip name="Cabinet" bits="9" ids="Upright,Cocktail"/>
        <dip name="Coin Mode" bits="10" ids="Mode 1,Mode 2" values="1,0"/>
        <dip name="Invulnerability (Cheat)" bits="14" ids="Off,On" values="1,0"/>
        <dip name="Service Mode" bits="15" ids="Off,On" values="1,0"/>
        <dip name="Stop Mode (Cheat)" bits="12" ids="Off,On" values="1,0"/>
        <dip name="Sector Selection (Cheat)" bits="13" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: MAME regions, packed store of rtl/irem1_board.sv (region table in index 1 bytes 64-111) -->
